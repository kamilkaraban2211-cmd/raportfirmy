# Użytkownik aplikacji (NIE właściciel tabel). Serwer odmówi startu jako właściciel.
DATABASE_URL=postgres://rf_app:HASLO@localhost:5432/raportfirmy?sslmode=require
# 32 losowe bajty w base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Utrata klucza = utrata NIP-ów. Trzymać poza repozytorium i w kopii w innym miejscu niż baza.
NIP_KEY=
APP_ORIGIN=https://raportfirmy.pl
PORT=3000
# 1 tylko za zaufanym proxy (np. hosting z Passengerem), żeby limity liczyły prawdziwy adres IP
TRUST_PROXY=0
